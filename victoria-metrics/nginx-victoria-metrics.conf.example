# nginx server block for VictoriaMetrics
#
# Place this file in /etc/nginx/servers.d/ (or include it from the main
# nginx.conf) and adjust the server_name to your subdomain.
#
# Request flow:
#   client -> nginx (TLS termination) -> vmauth (token check) -> vmagent
#
# All VictoriaMetrics components listen only on 127.0.0.1.

server {
    listen 443 ssl http2;
    server_name metrics.example.com;

    # --- TLS certificates (adjust paths) ---
    ssl_certificate     /etc/letsencrypt/live/metrics.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/metrics.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # --- Request size limit for metric ingestion ---
    client_max_body_size 100m;

    # --- Proxy to vmauth (token check) ---
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pass the Authorization header (Bearer token) to vmauth
        proxy_set_header Authorization $http_authorization;

        # Timeouts for long-running queries
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Redirect HTTP -> HTTPS
server {
    listen 80;
    server_name metrics.example.com;
    return 301 https://$host$request_uri;
}
